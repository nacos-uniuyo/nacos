# Copy this file to .env and fill in real values. Every variable is required.
# `bun run dev` and `bun run build` fail until each one is set, on purpose.

# Database (Neon Serverless PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
PGHOST=ep-xxxx-pooler.region.aws.neon.tech
PGUSER=user
PGDATABASE=neondb
PGPASSWORD=password

# Better Auth & Security
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=https://example.com

# Google OAuth
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# Cloudinary Media Assets
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
CLOUDINARY_CLOUD_NAME=replace-me
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=replace-me

# Application URLs
APP_URL=https://example.com
NEXT_PUBLIC_APP_URL=https://example.com
